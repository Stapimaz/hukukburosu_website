---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const practices = [
  { icon: 'briefcase', title: lang === 'tr' ? 'Ulusal ve Uluslararası Şirket Danışmanlığı' : 'National and International Corporate Consultancy', desc: lang === 'tr' ? 'Yerli ve yabancı şirketlerin kuruluşundan birleşme-devralma (M&A) süreçlerine, kurumsal yönetimden uluslararası ticari faaliyetlerine kadar uçtan uca stratejik hukuk danışmanlığı.' : 'End-to-end strategic legal consultancy for domestic and foreign companies, covering entity incorporation, mergers and acquisitions (M&A), corporate governance, and cross-border commercial operations.' },
  { icon: 'briefcase', title: lang === 'tr' ? 'Ticaret ve Şirketler Hukuku' : 'Commercial and Corporate Law', desc: lang === 'tr' ? 'Şirketler arası ticari uyuşmazlıklar, ortaklar arası ihtilaflar, genel kurul süreçleri, haksız rekabet davaları ve ticari risklerin yönetimi.' : 'Management of inter-company commercial disputes, shareholder conflicts, general assembly procedures, unfair competition claims, and commercial risk mitigation.' },
  { icon: 'document', title: lang === 'tr' ? 'Sözleşmeler Hukuku ve Risk Yönetimi' : 'Contract Law and Risk Management', desc: lang === 'tr' ? 'Ticari sözleşmelerin hazırlanması, uluslararası bayilik, distribütörlük ve lisans anlaşmalarının müzakeresi ile sözleşmesel risklerin önceden tespiti.' : 'Drafting commercial contracts, negotiating international dealership, distribution, and licensing agreements, and proactively identifying contractual risks.' },
  { icon: 'home', title: lang === 'tr' ? 'Göç ve Vatandaşlık Hukuku' : 'Immigration and Citizenship Law', desc: lang === 'tr' ? 'Yatırım yoluyla Türk vatandaşlığı kazanımı, ikamet ve çalışma izni başvuruları, sınır dışı (deport) kararlarına itiraz, tahdit kodlarının kaldırılması ve yabancı yatırımların hukuki yönetimi.' : 'Acquisition of Turkish citizenship by investment, residence and work permit applications, challenging deportation orders, removal of restriction codes, and legal management of foreign investments.' },
  { icon: 'scale', title: lang === 'tr' ? 'İcra-İflas Hukuku ve Kurumsal Alacak Yönetimi' : 'Execution-Bankruptcy Law and Corporate Debt Recovery', desc: lang === 'tr' ? 'Şirketlerin ve bireylerin yüksek hacimli alacaklarının tahsili, icra ve iflas takipleri, konkordato ile borç yapılandırma danışmanlığı.' : 'Recovery of high-value receivables for corporations and individuals, execution and bankruptcy proceedings, composition with creditors (concordat), and debt restructuring consultancy.' },
  { icon: 'shield', title: lang === 'tr' ? 'KVKK ve Veri Güvenliği' : 'Data Protection and Cybersecurity (KVKK & GDPR)', desc: lang === 'tr' ? '6698 sayılı KVKK ve GDPR kapsamında şirketlerin tam uyum projeleri, VERBİS kayıtları, veri transferi sözleşmeleri ve Kurul denetim süreçleri.' : 'Full compliance projects under Law No. 6698 (KVKK) and GDPR, VERBİS registrations, cross-border data transfer agreements, and representation during Data Protection Authority audits.' },
  { icon: 'briefcase', title: lang === 'tr' ? 'İş Hukuku ve Uyum Danışmanlığı' : 'Employment Law and Compliance Consultancy', desc: lang === 'tr' ? 'Şirketlerin iş hukuku süreçlerinin mevzuata uygunluğu, iş sözleşmeleri, işe iade ve tazminat davalarının yönetimi ile toplu iş hukuku danışmanlığı.' : 'Ensuring corporate business processes comply with labor regulations, drafting employment contracts, managing reinstatement and compensation claims, and providing collective labor law consultancy.' },
  { icon: 'shield', title: lang === 'tr' ? 'Sosyal Güvenlik Hukuku' : 'Social Security Law', desc: lang === 'tr' ? 'SGK mevzuatına uyum danışmanlığı, emeklilik süreçleri, iş kazası ve meslek hastalığından doğan tazminat ile hizmet tespiti davalarının yürütülmesi.' : 'Consultancy on Social Security Institution (SGK) regulations, retirement procedures, occupational accident and disease claims, and service determination lawsuits.' },
  { icon: 'home', title: lang === 'tr' ? 'Gayrimenkul, Kira ve İnşaat Hukuku' : 'Real Estate, Lease, and Construction Law', desc: lang === 'tr' ? 'Arsa payı karşılığı inşaat sözleşmeleri, kentsel dönüşüm, tapu iptal-tescil davaları, kira tespiti, tahliye davaları ve kat mülkiyeti yönetimi.' : 'Construction contracts in return for land share, urban transformation projects, title deed cancellation and registration lawsuits, lease determination, eviction proceedings, and condominium management.' },
  { icon: 'scale', title: lang === 'tr' ? 'Sigorta ve Tazminat Hukuku' : 'Insurance and Compensation Law', desc: lang === 'tr' ? 'Maddi ve manevi tazminat talepleri, trafik ve iş kazalarından doğan zararlar, poliçe uyuşmazlıkları ve Sigorta Tahkim Komisyonu başvuruları.' : 'Pecuniary and non-pecuniary damages claims, compensation arising from traffic and occupational accidents, insurance policy disputes, and representation before the Insurance Arbitration Commission.' },
  { icon: 'lightbulb', title: lang === 'tr' ? 'Fikri Mülkiyet Hukuku' : 'Intellectual Property Law', desc: lang === 'tr' ? 'Marka, patent, faydalı model ve tasarım tescil süreçleri, telif haklarının korunması ile fikri hak ihlallerine karşı hukuki koruma.' : 'Trademark, patent, utility model, and industrial design registration processes, protection of copyrights, and legal defense against intellectual property infringements.' },
  { icon: 'lightbulb', title: lang === 'tr' ? 'Bilişim ve Teknoloji Hukuku' : 'Information Technology and Media Law', desc: lang === 'tr' ? 'Yazılım ve lisans sözleşmeleri, e-ticaret mevzuatına uyum, dijital varlıkların korunması ve siber güvenlik odaklı hukuki danışmanlık.' : 'Drafting software and licensing agreements, e-commerce compliance, protection of digital assets, and legal consultancy focused on cybersecurity.' },
  { icon: 'document', title: lang === 'tr' ? 'Kamu İhale ve İdare Hukuku' : 'Public Procurement and Administrative Law', desc: lang === 'tr' ? 'Kamu ihalelerine katılım süreçleri, idari şartname analizleri, KİK itiraz başvuruları ile idari işlem ve eylemlere karşı iptal/tam yargı davaları.' : 'Assistance in public tender participation, analysis of administrative specifications, objection applications before the Public Procurement Authority (KİK), and annulment/full remedy lawsuits against administrative actions.' },
  { icon: 'scale', title: lang === 'tr' ? 'Ceza Hukuku' : 'Criminal Law', desc: lang === 'tr' ? 'Soruşturma ve kovuşturma aşamalarında şüpheli, sanık veya mağdur sıfatıyla müdafilik, vekillik ve etkili savunma hizmetleri.' : 'Effective defense and legal representation as defense counsel, victim\'s attorney, or intervenor during investigation and prosecution phases.' },
  { icon: 'home', title: lang === 'tr' ? 'Aile ve Boşanma Hukuku' : 'Family and Divorce Law', desc: lang === 'tr' ? 'Anlaşmalı ve çekişmeli boşanma davaları, velayet, nafaka, tazminat ile eşler arasındaki mal rejiminin tasfiyesi süreçleri.' : 'Uncontested and contested divorce proceedings, child custody, alimony, compensation claims, and the liquidation of matrimonial property regimes.' },
  { icon: 'document', title: lang === 'tr' ? 'Miras Hukuku' : 'Inheritance Law', desc: lang === 'tr' ? 'Vasiyetname ve miras sözleşmelerinin düzenlenmesi, tenkis, muris muvazaası (mirastan mal kaçırma) ve tereke paylaşım davaları.' : 'Drafting wills and inheritance contracts, lawsuits for reduction, claims regarding sham transactions to evade inheritance , and estate division proceedings.' },
  { icon: 'briefcase', title: lang === 'tr' ? 'Kooperatifler Hukuku' : 'Cooperatives Law', desc: lang === 'tr' ? 'Kooperatif kuruluşları, anasözleşme hazırlanması, genel kurul kararlarının iptali, üyelikten çıkarma ve yönetim sorumluluk davaları.' : 'Establishment of cooperatives, drafting articles of association, annulment of general assembly decisions, expulsion of members, and management liability lawsuits.' }
];
---

<section id={lang === 'tr' ? 'uzmanliklar' : 'practice'} class="py-24 bg-cream-100 dark:bg-navy-900 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <span class="text-xs font-bold uppercase tracking-[0.2em] text-gold-600 dark:text-gold-400">
        {lang === 'tr' ? 'Hukuki Danışmanlık & Çözümler' : 'Legal Expertise & Solutions'}
      </span>
      <h2 class="text-3xl sm:text-5xl font-serif font-bold text-navy-900 dark:text-cream-100 tracking-tight">
        {t('practice.title')}
      </h2>
      <div class="w-20 h-0.5 bg-gold-500 mx-auto"></div>
      <p class="text-sm sm:text-base text-navy-700 dark:text-cream-300 leading-relaxed font-light">
        {t('practice.subtitle')}
      </p>
    </div>

    <!-- Practice Areas Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {practices.map((item) => (
        <div class="bg-glass-card p-8 rounded-lg space-y-5 border border-navy-900/5 dark:border-white/5 hover:border-gold-500/50 group transition-all duration-300 relative overflow-hidden">
          
          <!-- Top Accent Line -->
          <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-gold-500 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
          
          <!-- Icon Box -->
          <div class="w-12 h-12 rounded bg-navy-900 dark:bg-gold-500/10 text-gold-400 dark:text-gold-400 flex items-center justify-center group-hover:scale-110 transition-transform">
            {item.icon === 'briefcase' && (
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            )}
            {item.icon === 'document' && (
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            )}
            {item.icon === 'shield' && (
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
            )}
            {item.icon === 'home' && (
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
            )}
            {item.icon === 'lightbulb' && (
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path></svg>
            )}
            {item.icon === 'scale' && (
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"></path></svg>
            )}
          </div>

          <!-- Title & Description -->
          <h3 class="text-xl font-serif font-bold text-navy-900 dark:text-cream-100 group-hover:text-gold-600 dark:group-hover:text-gold-400 transition-colors">
            {item.title}
          </h3>
          <p class="text-xs sm:text-sm text-navy-700 dark:text-cream-300/80 leading-relaxed font-light">
            {item.desc}
          </p>

        </div>
      ))}
    </div>

  </div>
</section>

