---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const references = [
  "Atılım Galvaniz Metal Sanayi ve Ticaret Limited Şirketi",
  "Dara 47 Yapı Denetim Limited Şirketi",
  "Gökçeli Yapı Denetim Limited Şirketi",
  "İz Global Enerji Mühendislik Danışmanlık Limited Şirketi",
  "ADAS Galvaniz Metal Sanayi Ticaret Limited Şirketi",
  "S.S. Beypazarı Tırcılar Kamyoncular ve Damperli Karayolu Yük Taşıma Kooperatifi",
  "Luqqadent Ağız ve Diş Sağlığı Hizmetleri Limited Şirketi"
];
---

<section id="referanslar" class="py-24 bg-white dark:bg-navy-950 transition-colors border-t border-navy-900/5 dark:border-white/5 relative overflow-hidden">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-gold-500/5 via-transparent to-transparent pointer-events-none"></div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <span class="text-xs font-bold uppercase tracking-[0.2em] text-gold-600 dark:text-gold-400">
        {lang === 'tr' ? 'İş Ortaklarımız' : 'Our Partners'}
      </span>
      <h2 class="text-3xl sm:text-5xl font-serif font-bold text-navy-900 dark:text-cream-100 tracking-tight">
        {lang === 'tr' ? 'Referanslarımız' : 'References'}
      </h2>
      <div class="w-20 h-0.5 bg-gold-500 mx-auto"></div>
      <p class="text-sm sm:text-base text-navy-700 dark:text-cream-300 leading-relaxed font-light">
        {lang === 'tr' 
          ? 'Sektörünün öncü şirketlerine ve kooperatiflerine sunduğumuz hukuki danışmanlık hizmetleriyle büyümeye ve değer katmaya devam ediyoruz.' 
          : 'We continue to grow and add value with the legal consultancy services we provide to leading companies and cooperatives in their sectors.'}
      </p>
    </div>

    <!-- References Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      {references.map((ref) => (
        <div class="bg-cream-50 dark:bg-navy-900 rounded-xl p-6 border border-navy-900/5 dark:border-white/5 flex items-center justify-center text-center hover:border-gold-500/50 hover:shadow-lg transition-all duration-300 group min-h-[120px]">
          <span class="text-sm font-semibold text-navy-800 dark:text-cream-200 group-hover:text-gold-600 dark:group-hover:text-gold-400 transition-colors line-clamp-3">
            {ref}
          </span>
        </div>
      ))}
    </div>

  </div>
</section>
